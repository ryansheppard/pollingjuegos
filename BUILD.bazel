config_setting(
    name = "opt",
    values = {"compilation_mode": "opt"},
    visibility = ["//visibility:public"],
)

# gnullvm rather than gnu: rustc generates Windows import libraries itself, so
# raw-dylib crates don't need an external dlltool the llvm toolchain lacks.
alias(
    name = "windows_x86_64",
    actual = "@rules_rs//rs/platforms:x86_64-pc-windows-gnullvm",
    visibility = ["//visibility:public"],
)
