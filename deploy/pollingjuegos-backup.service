[Unit]
Description=Back up pollingjuegos SQLite database

[Service]
Type=oneshot
# Match the distroless backend's nonroot UID/GID, which owns the SQLite files.
User=65532
Group=65532
ExecStart=/usr/local/bin/pollingjuegos-backup
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/pollingjuegos
