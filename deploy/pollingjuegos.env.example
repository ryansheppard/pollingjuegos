# Copy to /etc/pollingjuegos.env, owned by root:pollingjuegos and mode 0640.
# Use plain KEY=VALUE lines; this is a systemd EnvironmentFile, not a shell script.
DJANGO_SECRET_KEY=replace-with-a-long-random-persistent-value
DJANGO_ALLOWED_HOSTS=pj.ryansheppard.xyz
DJANGO_TRUST_PROXY=true
DISCORD_CLIENT_ID=replace-me
DISCORD_CLIENT_SECRET=replace-me
