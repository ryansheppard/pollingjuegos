FROM ghcr.io/astral-sh/uv:trixie AS builder

ENV UV_LINK_MODE=copy \
    UV_PYTHON_INSTALL_DIR=/python \
    UV_PYTHON_PREFERENCE=only-managed \
    UV_COMPILE_BYTECODE=1

WORKDIR /app
COPY .python-version pyproject.toml uv.lock ./
RUN uv python install && uv sync --locked --no-dev --no-install-project

COPY manage.py ./
COPY config/ ./config/
COPY polls/ ./polls/
COPY templates/ ./templates/
RUN .venv/bin/python manage.py collectstatic --noinput

FROM gcr.io/distroless/cc-debian13:nonroot
WORKDIR /app
COPY --from=builder /python /python
COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app/manage.py ./manage.py
COPY --from=builder /app/config ./config
COPY --from=builder /app/polls ./polls
COPY --from=builder /app/templates ./templates
COPY --from=builder /app/staticfiles ./staticfiles

ENV PATH=/app/.venv/bin:/usr/bin:/bin \
    DJANGO_DB_PATH=/data/db.sqlite3
EXPOSE 8000
CMD ["/app/.venv/bin/gunicorn", "--workers", "1", "--threads", "2", "--bind", "0.0.0.0:8000", "--access-logfile", "-", "--error-logfile", "-", "config.wsgi:application"]
