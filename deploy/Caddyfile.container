pj.ryansheppard.xyz {
    # Only Cloudflare connects (firewall + client cert), so a Cloudflare Origin
    # CA cert suffices and no ACME challenge needs to reach the droplet.
    tls /etc/caddy/tls/origin.pem /etc/caddy/tls/origin-key.pem {
        client_auth {
            mode require_and_verify
            trust_pool file /etc/caddy/tls/aop-client.pem
        }
    }
    @backend path /api /api/* /accounts /accounts/*
    handle @backend {
        reverse_proxy backend:8000
    }
    handle {
        forward_auth backend:8000 {
            uri /auth/frontend/
        }
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
