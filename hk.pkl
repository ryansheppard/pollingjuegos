amends "package://github.com/jdx/hk/releases/download/v2.3.1/hk@2.3.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.3.1/hk@2.3.1#/Builtins.pkl"

steps {
    ["gitleaks"] = Builtins.gitleaks
    ["taplo-format"] = Builtins.taplo_format
    ["shellcheck"] = Builtins.shellcheck
    ["shfmt"] = Builtins.shfmt
    ["terraform"] = Builtins.terraform
    ["oxlint"] {
        glob = List("frontend/**/*.ts", "frontend/**/*.vue")
        check = "frontend/node_modules/.bin/oxlint --deny-warnings --report-unused-disable-directives {{files}}"
        fix = "frontend/node_modules/.bin/oxlint --fix {{files}}"
    }
}
