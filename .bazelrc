common --repo_env=DO_NOT_TRACK=1

common --disk_cache=~/.bazel/disk_cache/pollingjuegoes
common --experimental_disk_cache_gc_max_size=20G
common --experimental_disk_cache_gc_max_age=14d

build --bes_results_url=https://ryansheppard.buildbuddy.io/invocation/
build --bes_backend=grpcs://ryansheppard.buildbuddy.io
common --remote_cache=grpcs://ryansheppard.buildbuddy.io
common --remote_timeout=10m
