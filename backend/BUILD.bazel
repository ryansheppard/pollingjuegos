load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_img//img:layer.bzl", "image_layer")
load("@rules_img//img:load.bzl", "image_load")
load("@rules_img//img:push.bzl", "image_push")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("@rules_rust//rust:defs.bzl", "rust_clippy_test", "rustfmt_test")
load(":image.bzl", "opt_image_manifest")

rust_library(
    name = "lib",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    aliases = aliases(),
    compile_data = glob(["migrations/**"]),
    crate_name = "backend",
    deps = all_crate_deps(normal = True),
)

rust_binary(
    name = "app",
    srcs = ["src/main.rs"],
    aliases = aliases(),
    # rules_rust ignores --strip; keep symbols outside opt for readable backtraces.
    rustc_flags = select({
        "//:opt": ["-Cstrip=symbols"],
        "//conditions:default": [],
    }),
    deps = [":lib"] + all_crate_deps(normal = True),
)

rust_test(
    name = "lib_test",
    size = "small",
    crate = ":lib",
)

# lib_test is listed so cfg(test) code is linted too.
rust_clippy_test(
    name = "clippy_test",
    size = "small",
    targets = [
        ":app",
        ":lib",
        ":lib_test",
    ],
)

rustfmt_test(
    name = "rustfmt_test",
    size = "small",
    targets = [
        ":app",
        ":lib",
    ],
)

image_layer(
    name = "layer",
    srcs = {"/app": "app"},
)

opt_image_manifest(
    name = "image",
    base = "@distroless_base_nossl",
    entrypoint = ["/app"],
    env = {
        "BIND_ADDR": "0.0.0.0:8000",
    },
    layers = [
        ":layer",
    ],
)

image_load(
    name = "load",
    daemon = "podman",
    image = ":image",
    registry = "registry.digitalocean.com",
    repository = "pollingjuegos/backend",
    tag = "latest",
)

image_push(
    name = "push",
    image = ":image",
    registry = "registry.digitalocean.com",
    repository = "pollingjuegos/backend",
)
