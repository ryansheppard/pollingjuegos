bazel_dep(name = "aspect_gazelle_prebuilt", version = "0.0.26")
bazel_dep(name = "aspect_rules_py", version = "2.0.0-alpha.8")
bazel_dep(name = "rules_img", version = "0.3.23")
bazel_dep(name = "aspect_rules_js", version = "3.5.1")
bazel_dep(name = "bazel_lib", version = "3.7.2")
bazel_dep(name = "rules_rs", version = "0.1.3")
bazel_dep(name = "llvm", version = "0.8.25")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "with_cfg.bzl", version = "0.12.0")

uv = use_extension("@aspect_rules_py//uv:extensions.bzl", "uv")
uv.declare_hub(
    hub_name = "pypi",
)
uv.project(
    hub_name = "pypi",
    lock = "//:uv.lock",
    pyproject = "//:pyproject.toml",
)
use_repo(uv, "pypi")

interpreters = use_extension("@aspect_rules_py//py:extensions.bzl", "python_interpreters")
interpreters.toolchain(python_version = "3.14")
interpreters.configure(
    build_config = "install_only_stripped",
    releases = ["20261013"],
)
use_repo(interpreters, "python_interpreters")

register_toolchains("@python_interpreters//:all")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    data = ["//frontend:pnpm-workspace.yaml"],
    pnpm_lock = "//frontend:pnpm-lock.yaml",
    public_hoist_packages = {
        "@vue/reactivity": ["frontend"],
        "@vue/runtime-core": ["frontend"],
        "@vue/runtime-dom": ["frontend"],
        "@vue/shared": ["frontend"],
    },
)
use_repo(npm, "npm")

pull = use_repo_rule("@rules_img//img:pull.bzl", "pull")

pull(
    name = "caddy",
    digest = "sha256:d8542f48d34a9cf4e4c11a478865229840e87e4c96ea3f439101f31a5d35f75f",
    registry = "docker.io",
    repository = "library/caddy",
    tag = "2.11.7-alpine",
)

pull(
    name = "distroless_cc",
    digest = "sha256:fe0b0247194032fa4c87259517e9686de4526f08caddbf169957264d06048a70",
    registry = "gcr.io",
    repository = "distroless/cc-debian13",
    tag = "nonroot",
)

pull(
    name = "distroless_base_nossl",
    digest = "sha256:e6b0f82595aa1edde72c8054de7a9dca30f0f8f54820c37a167c0ddfc21c5c67",
    registry = "gcr.io",
    repository = "distroless/base-nossl-debian13",
    tag = "nonroot",
)

toolchains = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")
toolchains.toolchain(
    edition = "2024",
    version = "1.99.1",
)
use_repo(toolchains, "default_rust_toolchains")

# rules_rs re-exports rules_rust's compile rules but not its lint rules, so
# expose the patched rules_rust it ships for rust_clippy_test.
rules_rust = use_extension("@rules_rs//rs:rules_rust.bzl", "rules_rust")
use_repo(rules_rust, "rules_rust")

register_toolchains(
    "@default_rust_toolchains//...",
    "@llvm//toolchain:all",
)

crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lock = "//:Cargo.lock",
    cargo_toml = "//:Cargo.toml",
    platform_triples = ["x86_64-unknown-linux-gnu"],
)

# build.rs uses env!("CARGO_MANIFEST_DIR"), which bakes the compile sandbox's
# absolute path into the build script; read it at runtime instead.
crate.annotation(
    crate = "libsqlite3-sys",
    patch_args = ["-p1"],
    patches = ["//rust/patches:libsqlite3-sys-manifest-dir.patch"],
)
use_repo(crate, "crates")
